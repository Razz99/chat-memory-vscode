{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch: extension",
			"type": "shell",
			"command": "yarn watch",
			"problemMatcher": [
				{
					"owner": "typescript",
					"fileLocation": [
						"relative",
						"${workspaceFolder}"
					],
					"pattern": {
						"regexp": "^ERROR in (.+?)\\((\\d+),(\\d+)\\):\\s+(TS\\d+):\\s+(.*)$",
						"file": 1,
						"line": 2,
						"column": 3,
						"code": 4,
						"message": 5
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": "\\[webpack-cli\\] Compiler starting...",
						"endsPattern": "\\[webpack-cli\\] Compiler finished"
					}
				}
			],
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
